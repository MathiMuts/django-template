# =============================================================================
#  Project configuration — copy to `.env` and adjust.
#  Read by Django AND docker compose; this is the only file you need to touch.
#  Everything else (db name/user, container names, hosts, ...) is derived.
# =============================================================================

# Lowercase letters, digits, - and _ only (also used as docker project name).
PROJECT_NAME=example

# True for development, False in production.
DJANGO_DEBUG=True

# Your domain(s), comma separated. localhost always works.
DOMAIN=

# True when a reverse proxy (Caddy, Traefik, host nginx, Cloudflare, ...) serves the site over HTTPS.
SSL_TLS=False

# Host port the app is published on. Use APP_BIND_ADDRESS=127.0.0.1 to only allow a proxy on the same machine.
APP_PORT=8000
APP_BIND_ADDRESS=0.0.0.0

# Database & cache, Django automatically uses what is listed here:
#   empty            -> SQLite (data/db.sqlite3) + RAM cache
#   postgres         -> postgres container instead of SQLite
#   redis            -> redis container as cache
#   postgres,redis   -> both
COMPOSE_PROFILES=

# Creates this admin user on container start (leave empty to skip).
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=

# Email: mails are sent as soon as a password is set, otherwise printed in the logs.
EMAIL_HOST_USER=mathi.muts.bot1@gmail.com
EMAIL_HOST_PASSWORD=
# Comma separated, get a mail on every server error (500) in production.
ADMIN_EMAILS=


# =============================================================================
#  Optional overrides — uncomment only when the default doesn't fit.
# =============================================================================

# DJANGO_SECRET_KEY=          # default: generated once and stored in data/.secret_key
# ADMIN_URL=admin/            # move the admin panel somewhere less guessable
# LANGUAGE_CODE=nl
# TIME_ZONE=Europe/Brussels
# LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
# GUNICORN_WORKERS=3

# Email server (port 465 = SSL, otherwise STARTTLS) and backend: console | smtp | none.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_BACKEND=none
