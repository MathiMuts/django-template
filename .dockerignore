# .dockerignore

# Git
.git
.gitignore

# Secrets / local config
.env

# Docker
Dockerfile
docker-compose.yml
docker-compose.override.yml
.dockerignore

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Node
node_modules/
npm-debug.log

# IDE / OS
.idea/
.vscode/
*.swp
*~
.DS_Store

# Runtime data (sqlite db, uploads) - mounted as a volume, not baked into the image
/data/
/media/

# Static files - generated by collectstatic, should not be in the image
/staticfiles/
/theme/static/

# Local DB
*.sqlite3
*.sqlite3-*